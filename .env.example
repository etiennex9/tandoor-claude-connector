# Copy to .env and fill in with your own hosts and secrets. Never commit .env.

# --- Gateway (Claude <-> Authentik) -----------------------------------------
# Public URL of the gateway, including the path prefix nginx strips.
# The Claude connector URL is this + /mcp.
PUBLIC_BASE_URL=https://recipe.example.com/claude

# Authentik OAuth2/OpenID provider for the "claude-tandoor" application.
OIDC_CONFIG_URL=https://login.example.com/application/o/claude-tandoor/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Signs the tokens the gateway issues to Claude and encrypts stored logins.
# Generate once:  openssl rand -hex 32
# Changing it signs everyone out (Claude will ask you to reconnect).
JWT_SIGNING_KEY=

# Optional second check on top of Authentik's policy binding: comma-separated
# Authentik emails or usernames allowed to connect. Empty = trust Authentik.
ALLOWED_USERS=

# --- Tandoor (gateway's tandoor-recipes-mcp child -> Tandoor) ---------------
TANDOOR_URL=https://recipe.example.com
# Tandoor -> Settings -> API Tokens -> create (read/write scope).
TANDOOR_TOKEN=
